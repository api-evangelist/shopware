{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shopware Admin Account Order API",
    "version": "6.7.9999999-dev"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Order",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{shopDomain}/api/order",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of resources per page (default 25)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              }
            ]
          },
          "docs": "Returns a paginated list of orders."
        },
        {
          "info": {
            "name": "Get an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{shopDomain}/api/order/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a single order by ID."
        },
        {
          "info": {
            "name": "Create order from cart",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{shopDomain}/api/checkout/order",
            "headers": [
              {
                "name": "sw-context-token",
                "value": ""
              }
            ]
          },
          "docs": "Converts the current cart into an order."
        },
        {
          "info": {
            "name": "List customer orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{shopDomain}/api/account/order",
            "headers": [
              {
                "name": "sw-context-token",
                "value": ""
              }
            ]
          },
          "docs": "Returns order history for the currently authenticated customer."
        }
      ]
    }
  ],
  "bundled": true
}