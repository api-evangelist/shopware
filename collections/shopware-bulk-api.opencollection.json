{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shopware Admin Account Bulk API",
    "version": "6.7.9999999-dev"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Bulk",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk sync entities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{shopDomain}/api/_action/sync",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Synchronises multiple entity operations (upsert / delete) in a single request. Ideal for bulk imports."
        }
      ]
    }
  ],
  "bundled": true
}